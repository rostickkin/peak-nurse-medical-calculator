              "ru": "Медленная ВВ инъекция в течение 3-5 минут или инфузия 10-30 минут"
            },
            "renalAdjustment": {
              "required": true,
              "note": { "th": "ต้องปรับขนาดยาตามการทำงานของไต (CrCl)", "en": "Dose adjustment required based on renal function (CrCl)", "ru": "Требуется коррекция дозы в зависимости от функции почек (КК)" }
