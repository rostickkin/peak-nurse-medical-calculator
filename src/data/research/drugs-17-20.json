            "route": "IV",
            "routeLabel": { "th": "ฉีดเข้าเส้นเลือดดำ (IV)", "en": "Intravenous (IV)", "ru": "Внутривенно (ВВ)" },
            "ageRange": { "min": 18 },
            "requiredInputs": [
              {
                "id": "weight",
