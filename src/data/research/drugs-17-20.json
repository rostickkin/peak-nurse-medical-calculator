              "rules": [
                {
                  "condition": "true",
                  "formula": "weight * 2.5",
                  "explanationTemplate": "Loading dose: 2.5 mg/kg IV once"
                }
              ]
            },
            "maxSingleDoseMg": 240,
            "maxDailyDoseMg": null,
            "frequency": {
              "th": "ให้ครั้งเดียวเป็นโดสโหลด (Loading dose)",
              "en": "Single loading dose",
              "ru": "Однократная загрузочная доза"
            },
